FROM node:24-bookworm-slim

RUN npm install --global pnpm@11.15.0
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY mobile/package.json mobile/package.json
COPY spacetimedb/package.json spacetimedb/package.json
RUN --mount=type=cache,target=/root/.local/share/pnpm/store pnpm install --filter praetorium.gg --frozen-lockfile

COPY . .
RUN NITRO_PRESET=node-server pnpm build && CI=true pnpm install --filter praetorium.gg --prod --frozen-lockfile

ARG GITHUB_SHA
LABEL org.opencontainers.image.source="https://github.com/richardsolomou/praetorium.gg"
ENV NODE_ENV=production PORT=3000 DATA_DIR=/data CATALOGUE_UPDATE_MODE=pinned GITHUB_SHA=$GITHUB_SHA
RUN mkdir /data && chown node:node /data
USER node
EXPOSE 3000
CMD ["node", "scripts/nodeCanary.ts"]
