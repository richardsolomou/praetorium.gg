{
  "expo": {
    "name": "Praetorium",
    "slug": "praetorium",
    "scheme": "praetorium",
    "version": "0.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "gg.praetorium",
      "supportsTablet": true,
      "associatedDomains": ["applinks:praetorium.gg"],
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "gg.praetorium",
      "adaptiveIcon": {
        "backgroundColor": "#0b0c0e",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "praetorium.gg"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b0c0e",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-web-browser"
    ]
  }
}
