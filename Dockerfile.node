# Every architecture shares one build, so hashed assets match across image variants; only production dependencies differ.
FROM --platform=$BUILDPLATFORM node:24.21.0-bookworm-slim AS build

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
RUN npm install --global pnpm@11.28.5
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY mobile/package.json mobile/package.json
COPY spacetimedb/package.json spacetimedb/package.json
RUN --mount=type=cache,target=/root/.local/share/pnpm/store pnpm install --filter praetorium.gg --frozen-lockfile

COPY . .
ARG VITE_POSTHOG_HOST
ARG VITE_POSTHOG_PROJECT_TOKEN
# Snapshots are private: the build reads one with the account ID and key pair this secret holds, on this step alone.
RUN --mount=type=cache,target=/app/.catalogue-objects \
    --mount=type=secret,id=catalogue_store \
    set -eu; \
    if [ -s /run/secrets/catalogue_store ]; then \
      read -r R2_ACCOUNT_ID R2_ACCESS_KEY_ID R2_SECRET_ACCESS_KEY < /run/secrets/catalogue_store; \
      export R2_ACCOUNT_ID R2_ACCESS_KEY_ID R2_SECRET_ACCESS_KEY; \
    fi; \
    CATALOGUE_CACHE_DIR=off pnpm catalogue:sync
ARG GITHUB_SHA
ARG POSTHOG_UPLOAD_SOURCEMAPS=false
ARG POSTHOG_CLI_HOST
ARG POSTHOG_CLI_PROJECT_ID
RUN --mount=type=cache,target=/root/.cache/praetorium/runtime \
    --mount=type=secret,id=posthog_api_key,env=POSTHOG_CLI_API_KEY \
    set -eu; \
    if [ "$POSTHOG_UPLOAD_SOURCEMAPS" = true ]; then \
      : "${POSTHOG_CLI_API_KEY:?PostHog source-map upload credential is required}" \
        "${POSTHOG_CLI_HOST:?PostHog host is required}" \
        "${POSTHOG_CLI_PROJECT_ID:?PostHog project is required}" \
        "${GITHUB_SHA:?Release revision is required}"; \
    fi; \
    POSTHOG_CLI_DRY_RUN=false NITRO_PRESET=node-server pnpm build; \
    if [ "$POSTHOG_UPLOAD_SOURCEMAPS" = true ]; then \
      POSTHOG_CLI_DRY_RUN=false pnpm exec posthog-cli sourcemap upload \
        --directory .output/public --release-name praetorium-web --release-version "$GITHUB_SHA" --release-mode symbol-set; \
    fi; \
    find .output/public -type f -name '*.map' -delete
ADD --checksum=sha256:154853dd882abe1e6f8b96e169f9ca43a075df006dd33116b85d03c59a912f89 https://github.com/clockworklabs/SpacetimeDB/releases/download/v2.12.0/spacetime-x86_64-unknown-linux-gnu.tar.gz /tmp/spacetime-amd64.tar.gz
ADD --checksum=sha256:3dd4785cf525d1029ab61177db2dc8cd303e04a73728ee611f5e1f4d2065b4ab https://github.com/clockworklabs/SpacetimeDB/releases/download/v2.12.0/spacetime-aarch64-unknown-linux-gnu.tar.gz /tmp/spacetime-arm64.tar.gz
ARG BUILDARCH
RUN tar -xzf "/tmp/spacetime-$BUILDARCH.tar.gz" -C /tmp spacetimedb-cli && /tmp/spacetimedb-cli build -p spacetimedb && rm -rf node_modules
# Nitro traced the build platform's native binary; the target platform's copy is added below.
RUN rm -r .output/server/node_modules/@libsql/linux-*

FROM node:24.21.0-bookworm-slim AS dependencies
RUN npm install --global pnpm@11.28.5
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY mobile/package.json mobile/package.json
COPY spacetimedb/package.json spacetimedb/package.json
RUN --mount=type=cache,target=/root/.local/share/pnpm/store CI=true pnpm install --filter praetorium.gg --prod --frozen-lockfile
RUN mkdir /native && cp -RL node_modules/.pnpm/node_modules/@libsql/linux-* /native/

FROM node:24.21.0-bookworm-slim
WORKDIR /app
COPY --from=build --chown=node:node /app /app
COPY --from=dependencies --chown=node:node /app/node_modules /app/node_modules
COPY --from=dependencies --chown=node:node /native/ /app/.output/server/node_modules/@libsql/
RUN node -e "require('/app/.output/server/node_modules/libsql')"

ARG GITHUB_SHA
LABEL org.opencontainers.image.source="https://github.com/richardsolomou/praetorium.gg"
ENV NODE_ENV=production PORT=3000 DATA_DIR=/data CATALOGUE_DIR=/app/catalogue-data RULES_DIR=/app/catalogue-data/rules CATALOGUE_UPDATE_MODE=off GITHUB_SHA=$GITHUB_SHA
RUN mkdir /data && chown node:node /data
USER node
EXPOSE 3000
CMD ["node", "scripts/nodeServer.ts"]
