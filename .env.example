# Public origin of the deployment. Mutations are rejected from any other origin,
# and any request for another hostname is redirected here with its path intact.
# Leave unset in local development.
APP_URL=

# Public, read-only base URL containing current.json and immutable catalogue
# snapshots. Leave unset to use Praetorium's shared public snapshot store.
CATALOGUE_SNAPSHOT_BASE_URL=

# Optional PostHog project token. When set, product analytics, session replay,
# feature flags, and browser/server error tracking are enabled through /t.
# VITE_POSTHOG_PROJECT_TOKEN=phc_...
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# Signs account sessions. Generated into DATA_DIR when unset. Changing it signs
# every player out, but their accounts and lists remain in the database.
AUTH_SECRET=

# Each sign-in provider appears only when both halves are set. Email and password
# works with no configuration at all.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Live updates go through Centrifugo, which the container runs itself behind the
# same port as the app. Leave these unset for that. Set them to point at a
# Centrifugo of your own: the secret signs the connection and subscription
# tokens, the API URL is where the app publishes, and the URL is what the browser
# is told to connect to (a path means "same origin as the app").
REALTIME_SECRET=
REALTIME_API_URL=
REALTIME_URL=

# Accounts, lists, battles and every command in their logs. Required: there is no
# default, because an instance pointing at nothing must fail rather than look well.
DATABASE_URL=postgres://praetorium:praetorium@127.0.0.1:5432/praetorium

# Connections each replica keeps open. Ten is enough for one; lower it when many
# replicas share a small Postgres.
# DATABASE_POOL_MAX=10

# Sessions, the auth rate limiter, and Centrifugo's fan-out between replicas.
# REDIS_URL is read too, for a host that names it that way.
# Leave it unset to run one replica: sessions then live in Postgres and live
# updates fan out inside the process, which is how self-hosting has always worked.
# More than one replica needs this set — without it, two players on different
# replicas never hear each other.
VALKEY_URL=redis://127.0.0.1:6379

# Signing secrets and the catalogue cache. The container defaults to /data.
DATA_DIR=./data-dev
