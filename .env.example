# Public origin of the deployment. Mutations are rejected from any other origin,
# and any request for another hostname is redirected here with its path intact.
# Leave unset in local development.
APP_URL=

# Signs account sessions. Generated into DATA_DIR when unset. Changing it signs
# every player out, but their accounts and lists remain in the database.
AUTH_SECRET=

# Each sign-in provider appears only when both halves are set. Email and password
# works with no configuration at all.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Live updates go through Centrifugo, which the container runs itself behind the
# same port as the app. Leave these unset for that. Set them to point at a
# Centrifugo of your own: the secret signs the connection and subscription
# tokens, the API URL is where the app publishes, and the URL is what the browser
# is told to connect to (a path means "same origin as the app").
REALTIME_SECRET=
REALTIME_API_URL=
REALTIME_URL=

# Where the SQLite database lives. The container defaults to /data.
DATA_DIR=./data-dev
