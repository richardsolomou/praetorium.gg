# `just dev` creates SQLite auth, object files, and SpacetimeDB data in data-dev/hosted/.
# It generates local credentials and does not need cloud credentials or Docker.
# Override these only when running multiple worktrees or using another CLI path.
# LOCAL_APP_PORT=3000
# LOCAL_SPACETIME_PORT=13000
# LOCAL_DATA_DIR=data-dev/hosted
# SPACETIME_BIN=/absolute/path/to/spacetime

# An optional mirror of verified catalogue snapshots. The default is the shared
# public catalogue service. `just catalogue-sync` installs the pinned snapshot.
CATALOGUE_BASE_URL=
CATALOGUE_DISABLED_SOURCES=

# Optional development-only combat-rule discovery key.
TYPESAFE_API_KEY=

# Optional social providers for local authentication tests. Configure matching
# callback URLs with each provider before using them in the browser.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CLIENT_SECRET=

# Optional GitHub Sponsors supporter badge. The OAuth app links a player's GitHub
# account and never signs in; the token (classic, read:user) belongs to the
# sponsored account and reads its active sponsors.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_SPONSORS_TOKEN=

# Optional product analytics for local builds.
# VITE_POSTHOG_PROJECT_TOKEN=phc_...
# VITE_POSTHOG_HOST=https://us.i.posthog.com
