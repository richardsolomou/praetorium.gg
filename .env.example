# Public origin of the deployment. Mutations are rejected from any other origin,
# and any request for another hostname is redirected here with its path intact.
# Leave unset in local development.
APP_URL=

# Release identity for verified iOS Universal Links and Android App Links.
# Leave unset until the matching signed store build exists.
APPLE_TEAM_ID=
ANDROID_APP_CERTIFICATE_SHA256_FINGERPRINTS=

# An S3-compatible store for profile pictures. `just dev` and Compose each run
# their own MinIO and fill these in unless already set; point at any
# S3-compatible endpoint instead for a real deployment. Leave unset entirely
# and uploading a picture fails with a clear error — nothing else depends on it.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Public, read-only base URL for that store — where a browser reads pictures
# back from, and current.json and immutable catalogue snapshots too. Leave
# unset to use Praetorium's shared public snapshot store for the catalogue;
# profile pictures still need S3_ENDPOINT above regardless.
S3_PUBLIC_BASE_URL=

# Optional PostHog project token. When set, product analytics, session replay,
# feature flags, and browser/server error tracking are enabled through /t.
# VITE_POSTHOG_PROJECT_TOKEN=phc_...
# VITE_POSTHOG_HOST=https://us.i.posthog.com

# Signs account sessions. Generated into DATA_DIR when unset. Changing it signs
# every player out, but their accounts and lists remain in the database.
AUTH_SECRET=

# Each sign-in provider appears only when its complete credentials are set. Email
# and password works with no configuration at all. Apple can generate its
# six-month client JWT from the signing key; APPLE_CLIENT_SECRET is the static
# alternative and must not be set with APPLE_KEY_ID and APPLE_PRIVATE_KEY.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CLIENT_SECRET=

# Optional SMTP delivery for email verification and password recovery. Set
# SMTP_HOST and EMAIL_FROM together. Set SMTP_USER and SMTP_PASSWORD together
# when the server requires authentication.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Live updates go through Centrifugo, which the container runs itself behind the
# same port as the app. Leave these unset for that. Set them to point at a
# Centrifugo of your own: the secret signs the connection and subscription
# tokens, the API URL is where the app publishes, and the URL is what the browser
# is told to connect to (a path means "same origin as the app").
REALTIME_SECRET=
REALTIME_API_URL=
REALTIME_URL=

# Accounts, lists, battles and every command in their logs. Required: there is no
# default, because an instance pointing at nothing must fail rather than look well.
DATABASE_URL=postgres://praetorium:praetorium@127.0.0.1:5432/praetorium

# Connections each replica keeps open. Ten is enough for one; lower it when many
# replicas share a small Postgres.
# DATABASE_POOL_MAX=10

# Sessions, the auth rate limiter, and Centrifugo's fan-out between replicas.
# REDIS_URL is read too, for a host that names it that way.
# Leave it unset to run one replica: sessions then live in Postgres and live
# updates fan out inside the process, which is how self-hosting has always worked.
# More than one replica needs this set — without it, two players on different
# replicas never hear each other.
VALKEY_URL=redis://127.0.0.1:6379

# Signing secrets and the catalogue cache. The container defaults to /data.
DATA_DIR=./data-dev

# Compose reads these from this file too. docker-compose.yml requires
# POSTGRES_PASSWORD; the rest, including the S3_* variables above, have the
# defaults shown in docker-compose.yml itself. DATA_HOST_DIR is where the
# /data volume lives on the host.
#POSTGRES_USER=praetorium
POSTGRES_PASSWORD=
#POSTGRES_DB=praetorium
#DATA_HOST_DIR=./praetorium-data
