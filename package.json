{
  "name": "praetorium.gg",
  "version": "0.280.28",
  "private": true,
  "description": "Build Warhammer 40,000 armies and track games from setup to final score.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "vite build && vite build --config vite.seed.config.ts && tsx scripts/compileCatalogueRuntime.ts",
    "typecheck": "tsc --noEmit && pnpm --dir mobile typecheck && pnpm --dir spacetimedb typecheck",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity=error .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "docs:lint": "markdownlint-cli2 '**/*.md' '#**/node_modules' '#.output' '#data-dev' '#catalogue-data' '#mobile/ios/**' '#mobile/.simulator-derived/**' '#CHANGELOG.md' '#test-results*/**' '#playwright-report/**'",
    "vocabulary:check": "tsx scripts/checkVocabulary.ts",
    "check": "pnpm format:check && pnpm lint && pnpm docs:lint && pnpm vocabulary:check && pnpm changesets:check && pnpm auth:db:check && pnpm catalogue:check && pnpm build && pnpm typecheck && pnpm test",
    "test": "vitest run && pnpm test:python",
    "test:python": "python3 -B -m unittest discover -s scripts -p 'test_*.py'",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:spacetime": "tsx scripts/spacetimeIntegration.ts",
    "spacetime:generate": "spacetime generate --lang typescript --module-path spacetimedb --out-dir src/spacetime/generated --yes && oxfmt src/spacetime/generated",
    "changeset": "changeset",
    "version-packages": "changeset version && tsx scripts/dateChangelog.ts && tsx scripts/archiveChangelog.ts && tsx scripts/syncMobileVersion.ts && oxfmt --write mobile/app.json",
    "release": "changeset git-tag",
    "auth:db:generate": "drizzle-kit generate --config drizzle.auth.config.ts",
    "auth:db:check": "drizzle-kit check --config drizzle.auth.config.ts",
    "catalogue:check": "tsx scripts/syncCatalogue.ts --check",
    "catalogue:compile": "tsx scripts/compileCatalogue.ts",
    "catalogue:combat": "tsx scripts/auditCombatRules.ts",
    "catalogue:combat:eval": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/checkCombatRuleQuestions.ts",
    "catalogue:combat:shortlist": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/shortlistCombatRules.ts",
    "catalogue:history": "node --max-old-space-size=8192 --import tsx scripts/catalogueHistory.ts",
    "catalogue:history-seed": "node --max-old-space-size=8192 --import tsx scripts/catalogueHistorySeed.ts",
    "catalogue:descriptions": "tsx scripts/checkDescriptions.ts",
    "catalogue:terrain": "tsx scripts/checkTerrain.ts",
    "catalogue:sync": "tsx scripts/syncCatalogue.ts",
    "catalogue:snapshot": "tsx scripts/catalogueSnapshot.ts",
    "catalogue:materialize": "tsx scripts/materializeCatalogue.ts",
    "catalogue:coverage": "node --max-old-space-size=8192 --import tsx scripts/catalogueCoverage.ts",
    "catalogue:coverage:parallel": "tsx scripts/parallelCatalogueCoverage.ts",
    "catalogue:coverage:compare": "tsx scripts/compareCatalogueCoverage.ts",
    "reference:evaluate": "tsx scripts/evaluateReference.ts",
    "reference:verify": "tsx scripts/verifyReferenceDeployment.ts",
    "catalogue:points": "node --max-old-space-size=8192 --import tsx scripts/checkPoints.ts && tsx scripts/checkRestrictions.ts && tsx scripts/checkJoins.ts && tsx scripts/checkVsDataCoverage.ts",
    "mobile": "pnpm --dir mobile start",
    "changesets:check": "tsx scripts/checkChangesets.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/cimd": "1.7.25",
    "@better-auth/mcp": "1.7.25",
    "@better-auth/oauth-provider": "1.7.25",
    "@fontsource-variable/martian-mono": "5.3.0",
    "@fontsource-variable/sofia-sans-semi-condensed": "5.3.0",
    "@fontsource/barlow": "5.3.0",
    "@fontsource/sofia-sans-semi-condensed": "5.3.0",
    "@libsql/client": "0.18.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.301.2",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-logs": "3.1.1",
    "@posthog/mcp": "1.6.1",
    "@posthog/react": "1.11.3",
    "@resvg/resvg-wasm": "2.6.2",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.169.5",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "aws4fetch": "1.0.20",
    "better-auth": "1.7.25",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "core-js": "^3.51.0",
    "drizzle-orm": "0.45.4",
    "fastest-levenshtein": "1.0.16",
    "fflate": "^0.8.3",
    "http-proxy": "1.18.1",
    "idb-keyval": "6.3.0",
    "jose": "^6.2.17",
    "lucide-react": "^1.73.0",
    "next-themes": "^0.4.6",
    "openskill": "5.0.1",
    "p-retry": "^9.0.0",
    "posthog-js": "1.453.2",
    "posthog-node": "6.0.5",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "satori": "0.63.2",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
    "spacetimedb": "2.15.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@changesets/cli": "3.0.3",
    "@changesets/parse": "1.0.0",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "1.65.1",
    "@posthog/cli": "0.20.1",
    "@posthog/rollup-plugin": "1.6.4",
    "@tailwindcss/vite": "4.3.5",
    "@types/canvas-confetti": "^1.9.0",
    "@types/http-proxy": "1.17.17",
    "@types/node": "26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typesafe-ai/sdk": "0.7.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "drizzle-kit": "^0.31.11",
    "happy-dom": "21.0.4",
    "markdownlint-cli2": "0.24.1",
    "nitro": "3.0.260903-beta",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "ras-stack": "^6.0.0",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.13.0"
}
