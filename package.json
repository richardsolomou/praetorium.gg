{
  "name": "praetorium.gg",
  "version": "0.195.7",
  "private": true,
  "description": "Build Warhammer 40,000 armies and track games from setup to final score.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "ras build && ras build --config vite.seed.config.ts && tsx scripts/compileCatalogueRuntime.ts",
    "typecheck": "ras typecheck && pnpm --dir mobile typecheck && pnpm --dir spacetimedb typecheck",
    "lint": "ras lint --report-unused-disable-directives-severity=error .",
    "lint:fix": "ras lint --fix .",
    "format": "ras format .",
    "format:check": "ras format --check .",
    "docs:lint": "markdownlint-cli2 '**/*.md' '#**/node_modules' '#.output' '#data-dev' '#catalogue-data' '#mobile/ios/**' '#mobile/.simulator-derived/**' '#CHANGELOG.md' '#test-results*/**' '#playwright-report/**'",
    "check": "ras sync --check && pnpm format:check && pnpm lint && pnpm docs:lint && pnpm changesets:check && pnpm auth:db:check && pnpm catalogue:check && pnpm build && pnpm typecheck && pnpm test",
    "test": "ras test && pnpm test:python",
    "test:python": "python3 -B -m unittest discover -s scripts -p 'test_*.py'",
    "test:unit": "ras test --config vitest.unit.config.ts",
    "test:integration": "ras test --config vitest.integration.config.ts",
    "changeset": "changeset",
    "version-packages": "changeset version && tsx scripts/syncMobileVersion.ts && oxfmt --write mobile/app.json",
    "release": "changeset git-tag",
    "auth:db:generate": "drizzle-kit generate --config drizzle.auth.config.ts",
    "auth:db:check": "drizzle-kit check --config drizzle.auth.config.ts",
    "catalogue:check": "tsx scripts/syncCatalogue.ts --check",
    "catalogue:compile": "tsx scripts/compileCatalogue.ts",
    "catalogue:combat": "tsx scripts/auditCombatRules.ts",
    "catalogue:combat:eval": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/checkCombatRuleQuestions.ts",
    "catalogue:combat:shortlist": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/shortlistCombatRules.ts",
    "catalogue:history": "node --max-old-space-size=8192 --import tsx scripts/catalogueHistory.ts",
    "catalogue:history-seed": "node --max-old-space-size=8192 --import tsx scripts/catalogueHistorySeed.ts",
    "catalogue:descriptions": "tsx scripts/checkDescriptions.ts",
    "catalogue:terrain": "tsx scripts/checkTerrain.ts",
    "catalogue:sync": "tsx scripts/syncCatalogue.ts",
    "catalogue:snapshot": "tsx scripts/catalogueSnapshot.ts",
    "catalogue:materialize": "tsx scripts/materializeCatalogue.ts",
    "catalogue:coverage": "node --max-old-space-size=8192 --import tsx scripts/catalogueCoverage.ts",
    "catalogue:coverage:parallel": "tsx scripts/parallelCatalogueCoverage.ts",
    "catalogue:coverage:compare": "tsx scripts/compareCatalogueCoverage.ts",
    "reference:evaluate": "tsx scripts/evaluateReference.ts",
    "reference:verify": "tsx scripts/verifyReferenceDeployment.ts",
    "catalogue:points": "node --max-old-space-size=8192 --import tsx scripts/checkPoints.ts && tsx scripts/checkRestrictions.ts && tsx scripts/checkJoins.ts",
    "benchmark:pricing": "tsx scripts/benchmarkProductionPricing.ts",
    "mobile": "pnpm --dir mobile start",
    "changesets:check": "ras changesets check"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/cimd": "1.7.10",
    "@better-auth/mcp": "1.7.10",
    "@better-auth/oauth-provider": "1.7.10",
    "@fontsource-variable/martian-mono": "5.3.0",
    "@fontsource-variable/sofia-sans-semi-condensed": "5.3.0",
    "@fontsource/chakra-petch": "5.3.0",
    "@fontsource/sofia-sans-semi-condensed": "5.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@posthog/mcp": "0.22.3",
    "@resvg/resvg-wasm": "2.6.2",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.20",
    "aws4fetch": "1.0.20",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "core-js": "^3.50.0",
    "fastest-levenshtein": "1.0.16",
    "fflate": "^0.8.3",
    "http-proxy": "1.18.1",
    "idb-keyval": "6.3.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.58.0",
    "next-themes": "^0.4.6",
    "openskill": "5.0.1",
    "p-retry": "^8.0.1",
    "qrcode": "^1.5.4",
    "react-markdown": "10.1.0",
    "satori": "0.62.0",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
    "spacetimedb": "2.12.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@jridgewell/trace-mapping": "0.3.31",
    "@posthog/cli": "0.18.10",
    "@types/canvas-confetti": "^1.9.0",
    "@types/http-proxy": "1.17.17",
    "@types/qrcode": "^1.5.6",
    "@typesafe-ai/sdk": "0.7.0",
    "drizzle-kit": "^0.31.11",
    "markdownlint-cli2": "0.23.3",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.13.0"
}
