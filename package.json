{
  "name": "praetorium.gg",
  "version": "0.48.1",
  "private": true,
  "description": "Build Warhammer 40,000 armies and track games from setup to final score.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "realtime": "sh scripts/realtime.sh",
    "build": "vite build && vite build --config vite.seed.config.ts && esbuild scripts/containerRuntime.ts --bundle --platform=node --format=esm --target=node24 --outfile=.output/server/container-runtime.mjs --log-level=warning && esbuild scripts/migrate.ts --bundle --platform=node --format=esm --target=node24 --outfile=.output/server/migrate.mjs --log-level=warning && esbuild scripts/previewDatabase.ts --bundle --platform=node --format=esm --target=node24 --outfile=.output/server/preview-database.mjs --log-level=warning && ras assets sync",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit && pnpm --dir mobile typecheck",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity=error .",
    "lint:fix": "oxlint --type-aware --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "docs:lint": "markdownlint-cli2 '**/*.md' '#**/node_modules' '#.output' '#catalogue-data' '#CHANGELOG.md'",
    "policy:sync": "ras policy sync",
    "policy:check": "ras policy check",
    "check": "pnpm format:check && pnpm lint && pnpm docs:lint && pnpm policy:check && pnpm db:check && pnpm catalogue:check && pnpm check:changesets && pnpm build && pnpm typecheck && pnpm test",
    "test": "vitest run",
    "check:changesets": "tsx scripts/checkChangesets.ts",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset git-tag",
    "test:e2e": "docker build -t praetorium-e2e . && playwright test",
    "test:e2e:run": "playwright test",
    "test:e2e:native-auth:ios": "tsx e2e/nativeAuthIos.ts",
    "test:e2e:install": "playwright install chromium --only-shell",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "catalogue:check": "tsx scripts/syncCatalogue.ts --check",
    "catalogue:descriptions": "tsx scripts/checkDescriptions.ts",
    "catalogue:terrain": "tsx scripts/checkTerrain.ts",
    "catalogue:sync": "tsx scripts/syncCatalogue.ts",
    "catalogue:snapshot": "tsx scripts/catalogueSnapshot.ts",
    "catalogue:update": "tsx scripts/syncCatalogue.ts --update",
    "catalogue:coverage": "node --max-old-space-size=8192 --import tsx scripts/catalogueCoverage.ts",
    "catalogue:points": "node --max-old-space-size=8192 --import tsx scripts/checkPoints.ts && tsx scripts/checkRestrictions.ts && tsx scripts/checkJoins.ts",
    "benchmark:roster": "tsx scripts/benchmarkRosterLoading.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seedPreview.ts",
    "profile-images:migrate": "tsx scripts/migrateProfileImages.ts",
    "mobile": "pnpm --dir mobile start",
    "mobile:android": "pnpm --dir mobile android",
    "mobile:ios": "pnpm --dir mobile ios"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1112.0",
    "@base-ui/react": "^1.7.0",
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-semi-condensed": "5.3.0",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@posthog/react": "^1.10.3",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.29",
    "@tanstack/react-router-ssr-query": "^1.167.1",
    "@tanstack/react-start": "^1.168.46",
    "better-auth": "^1.7.0",
    "centrifuge": "^5.7.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.11.0",
    "fastest-levenshtein": "1.0.16",
    "fflate": "^0.8.3",
    "iovalkey": "^0.4.0",
    "jose": "^6.2.9",
    "lucide-react": "^1.31.0",
    "nodemailer": "^9.0.5",
    "p-retry": "^8.0.0",
    "postgres": "^3.4.9",
    "posthog-js": "^1.417.4",
    "posthog-node": "^5.49.1",
    "qrcode": "^1.5.4",
    "ras-stack": "^0.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "10.1.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.0",
    "@changesets/parse": "1.0.0",
    "@electric-sql/pglite": "^0.5.5",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.28.2",
    "markdownlint-cli2": "0.23.2",
    "nitro": "3.0.260610-beta",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.15.0"
}
