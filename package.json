{
  "name": "praetorium.gg",
  "version": "0.99.0",
  "private": true,
  "description": "Build Warhammer 40,000 armies and track games from setup to final score.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "vite build && vite build --config vite.seed.config.ts",
    "start:node": "node scripts/nodeServer.ts",
    "auth:node:backup": "node scripts/nodeAuthBackup.ts backup",
    "typecheck": "tsc --noEmit && pnpm --dir mobile typecheck && pnpm --dir spacetimedb typecheck",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives-severity=error .",
    "lint:fix": "oxlint --type-aware --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "docs:lint": "markdownlint-cli2 '**/*.md' '#**/node_modules' '#.output' '#catalogue-data' '#mobile/ios/**' '#mobile/.simulator-derived/**' '#CHANGELOG.md'",
    "policy:sync": "ras policy sync",
    "policy:check": "ras policy check",
    "architecture:check": "tsx scripts/checkImportBoundaries.ts",
    "check": "pnpm format:check && pnpm lint && pnpm docs:lint && pnpm policy:check && pnpm architecture:check && pnpm auth:db:check && pnpm catalogue:check && pnpm build && pnpm typecheck && pnpm test",
    "test": "vitest run && python3 -B -m unittest discover -s scripts -p 'test_*.py'",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "check:changesets": "ras policy check",
    "changeset": "changeset",
    "version-packages": "changeset version && tsx scripts/clearAcceptedCoverageLosses.ts",
    "release": "changeset git-tag",
    "test:e2e": "playwright test",
    "test:e2e:native-auth:ios": "tsx e2e/nativeAuthIos.ts",
    "test:e2e:install": "playwright install chromium --only-shell",
    "auth:db:generate": "drizzle-kit generate --config drizzle.auth.config.ts",
    "auth:db:check": "drizzle-kit check --config drizzle.auth.config.ts",
    "catalogue:check": "tsx scripts/syncCatalogue.ts --check",
    "catalogue:upstream": "tsx scripts/syncCatalogue.ts --upstream",
    "catalogue:compile": "tsx scripts/compileCatalogue.ts",
    "catalogue:profiles:compare": "tsx scripts/compareProjectedProfiles.ts",
    "catalogue:combat": "tsx scripts/auditCombatRules.ts",
    "catalogue:combat:eval": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/checkCombatRuleQuestions.ts",
    "catalogue:combat:shortlist": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import tsx scripts/shortlistCombatRules.ts",
    "catalogue:audit": "tsx scripts/auditCanonicalCatalogue.ts",
    "catalogue:history": "node --max-old-space-size=8192 --import tsx scripts/catalogueHistory.ts",
    "catalogue:history-seed": "node --max-old-space-size=8192 --import tsx scripts/catalogueHistorySeed.ts",
    "catalogue:descriptions": "tsx scripts/checkDescriptions.ts",
    "catalogue:terrain": "tsx scripts/checkTerrain.ts",
    "catalogue:sync": "tsx scripts/syncCatalogue.ts",
    "catalogue:snapshot": "tsx scripts/catalogueSnapshot.ts",
    "catalogue:update": "tsx scripts/materializeCatalogue.ts",
    "catalogue:materialize": "tsx scripts/materializeCatalogue.ts",
    "catalogue:supplemental": "tsx scripts/syncCatalogue.ts --supplemental",
    "catalogue:coverage": "node --max-old-space-size=8192 --import tsx scripts/catalogueCoverage.ts",
    "catalogue:coverage:parallel": "tsx scripts/parallelCatalogueCoverage.ts",
    "catalogue:coverage:compare": "tsx scripts/compareCatalogueCoverage.ts",
    "reference:evaluate": "tsx scripts/evaluateReference.ts",
    "reference:verify": "tsx scripts/verifyReferenceDeployment.ts",
    "catalogue:points": "node --max-old-space-size=8192 --import tsx scripts/checkPoints.ts && tsx scripts/checkRestrictions.ts && tsx scripts/checkJoins.ts",
    "benchmark:roster": "tsx scripts/benchmarkRosterLoading.ts",
    "db:seed": "tsx scripts/seedPreview.ts",
    "mobile": "pnpm --dir mobile start",
    "mobile:android": "pnpm --dir mobile android",
    "mobile:ios": "pnpm --dir mobile ios",
    "dev:status": "tsx scripts/dev.ts status",
    "dev:stop": "tsx scripts/dev.ts stop",
    "dev:restart": "tsx scripts/dev.ts restart"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@better-auth/cimd": "1.7.5",
    "@better-auth/mcp": "1.7.5",
    "@better-auth/oauth-provider": "1.7.5",
    "@fontsource-variable/martian-mono": "5.3.0",
    "@fontsource-variable/sofia-sans-semi-condensed": "5.3.0",
    "@fontsource/chakra-petch": "5.3.0",
    "@fontsource/sofia-sans-semi-condensed": "5.3.0",
    "@libsql/client": "0.18.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@posthog/mcp": "0.17.0",
    "@posthog/react": "^1.10.6",
    "@resvg/resvg-wasm": "2.6.2",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.56",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.13",
    "aws4fetch": "1.0.20",
    "better-auth": "^1.7.5",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "fastest-levenshtein": "1.0.16",
    "fflate": "^0.8.3",
    "http-proxy": "1.18.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.31.0",
    "nodemailer": "^9.0.6",
    "openskill": "5.0.1",
    "p-retry": "^8.0.1",
    "posthog-js": "^1.430.3",
    "posthog-node": "^5.52.4",
    "qrcode": "^1.5.4",
    "ras-stack": "^2.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "10.1.0",
    "satori": "0.32.0",
    "spacetimedb": "2.7.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@playwright/test": "^1.62.1",
    "@posthog/cli": "0.14.1",
    "@posthog/rollup-plugin": "1.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/http-proxy": "1.17.17",
    "@types/node": "^24.13.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.7",
    "@typesafe-ai/sdk": "0.5.7",
    "@vitejs/plugin-react": "^6.0.3",
    "drizzle-kit": "^0.31.10",
    "markdownlint-cli2": "0.23.3",
    "nitro": "3.0.260610-beta",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2002",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.15.0"
}
