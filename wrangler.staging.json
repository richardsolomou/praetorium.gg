{
  "name": "praetorium-staging",
  "main": "cloudflare/nativeWorker.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_URL": "https://staging.praetorium.gg",
    "SPACETIME_AUDIENCE": "praetorium-staging",
    "SPACETIME_DATABASE": "praetorium-staging"
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "praetorium-auth-staging",
      "database_id": "a776d5fd-d22a-4683-8dbf-e2b36a023f47"
    }
  ],
  "r2_buckets": [{ "binding": "PUBLIC_OBJECTS", "bucket_name": "praetorium-catalogue" }],
  "assets": { "directory": ".output/public", "binding": "ASSETS", "run_worker_first": ["/_catalogue/*"] }
}
