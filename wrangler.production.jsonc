{
  "name": "praetorium-production",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_URL": "https://praetorium.gg",
    "SPACETIME_AUDIENCE": "praetorium-production",
    "SPACETIME_DATABASE": "praetorium-production",
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "praetorium-auth-production",
      "database_id": "9cc4275f-c3e1-4ea3-9e6e-b5337259dfee",
    },
  ],
  "containers": [
    {
      "class_name": "WebContainer",
      "image": "./Dockerfile.cloudflare",
      "max_instances": 1,
      "instance_type": "basic",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "WEB", "class_name": "WebContainer" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WebContainer"] }],
}
