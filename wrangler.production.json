{
  "name": "praetorium-production",
  "main": "cloudflare/nativeWorker.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_URL": "https://praetorium.gg",
    "SPACETIME_AUDIENCE": "praetorium-production",
    "SPACETIME_DATABASE": "praetorium-production"
  },
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "praetorium-auth-production",
      "database_id": "9cc4275f-c3e1-4ea3-9e6e-b5337259dfee"
    }
  ],
  "r2_buckets": [{ "binding": "PUBLIC_OBJECTS", "bucket_name": "praetorium-catalogue" }],
  "assets": { "directory": ".output/public", "binding": "ASSETS", "run_worker_first": ["/_catalogue/*"] }
}
