{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./.ras/oxlint.json"],
  "rules": {
    "typescript/no-deprecated": "error"
  },
  "overrides": [
    {
      "files": ["scripts/**"],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      "files": ["src/core/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(?:node:|(?:assert|async_hooks|buffer|child_process|cluster|console|constants|crypto|dgram|diagnostics_channel|dns|domain|events|fs|http|http2|https|inspector|module|net|os|path|perf_hooks|process|punycode|querystring|readline|repl|stream|string_decoder|sys|timers|tls|trace_events|tty|url|util|v8|vm|wasi|worker_threads|zlib)(?:/|$))",
                "message": "Domain modules must not import Node builtins."
              },
              {
                "regex": "^(@tanstack/|react(?:/|-|$)|@testing-library/|drizzle-orm(?:/|$)|postgres(?:/|$)|iovalkey(?:/|$)|ioredis(?:/|$)|@electric-sql/|better-auth(?:/|$)|cheerio(?:/|$)|html-to-text(?:/|$)|centrifuge(?:/|$)|posthog-(?:js|node)(?:/|$))",
                "message": "Domain modules must not import framework or persistence dependencies."
              },
              {
                "regex": "^(?:(?:\\.\\.?/)+|@/)(?:adapters|client|components|db|lib|routes|server)/",
                "message": "Domain modules must not import application layers."
              },
              {
                "regex": "^(?:(?:\\.\\.?/)+|@/)contracts/",
                "message": "Core must own its domain types."
              }
            ]
          }
        ]
      },
      "excludeFiles": ["**/*.test.*", "**/*.spec.*"]
    },
    {
      "files": ["src/client/components/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/adapters/**",
                  "**/db/**",
                  "**/routes/**",
                  "**/server/**",
                  "!**/server/functions",
                  "!**/server/functions.*",
                  "!**/server/functions/**",
                  "!**/server/fns",
                  "!**/server/fns.*"
                ],
                "message": "Client modules may import server functions, but not server implementations."
              },
              {
                "regex": "^(?:(?:\\.\\.?/)+(?:client/)?|@/client/)features/",
                "message": "Shared components must not depend on a product feature."
              }
            ]
          }
        ]
      },
      "excludeFiles": ["**/*.test.*", "**/*.spec.*"]
    }
  ],
  "ignorePatterns": [
    "src/routeTree.gen.ts",
    "src/spacetime/generated/**",
    ".output/**",
    "node_modules/**",
    "src/components/ui/**",
    ".ras/**",
    ".pnpmfile.cjs"
  ],
  "env": {
    "builtin": true
  }
}
