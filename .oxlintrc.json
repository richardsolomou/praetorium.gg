{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": [
    "./node_modules/ras-stack-config/config/oxlint/application.json",
    "./node_modules/ras-stack-config/config/oxlint/tanstack.json",
    "./node_modules/ras-stack-config/config/oxlint/domain.json",
    "./node_modules/ras-stack-config/config/oxlint/layers.json"
  ],
  "rules": {
    "typescript/no-deprecated": "error",
    "react/exhaustive-effect-dependencies": "off",
    "react/immutability": "off",
    "react/incompatible-library": "off",
    "react/memo-dependencies": "off",
    "react/preserve-manual-memoization": "off",
    "react/purity": "off",
    "react/refs": "off",
    "react/set-state-in-effect": "off"
  },
  "overrides": [
    {
      "files": ["scripts/**"],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off"
      }
    }
  ],
  "ignorePatterns": ["src/routeTree.gen.ts", "src/spacetime/generated/**", ".output/**", "node_modules/**", "src/components/ui/**"],
  "env": {
    "builtin": true
  }
}
