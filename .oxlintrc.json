{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/ras-stack/config/oxlint/application.json", "./node_modules/ras-stack/config/oxlint/tanstack.json"],
  "rules": {
    "typescript/no-deprecated": "error"
  },
  "overrides": [
    {
      "files": ["scripts/**"],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      "files": ["src/routes/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [{ "regex": "^\\./[^.]", "message": "Route modules must not import sibling route modules." }]
          }
        ]
      }
    },
    {
      "files": ["src/core/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(node:|@tanstack/|react(?:/|$)|\\.\\./(?:adapters|client|db|routes|server)/)",
                "message": "Core modules must remain free of IO and framework dependencies."
              }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": ["src/routeTree.gen.ts", ".output/**", "node_modules/**", "src/components/ui/**"],
  "env": {
    "builtin": true
  }
}
