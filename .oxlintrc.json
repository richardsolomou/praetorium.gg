{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/ras-stack/config/oxlint/application.json", "./node_modules/ras-stack/config/oxlint/tanstack.json"],
  "rules": {
    "typescript/no-deprecated": "error"
  },
  "overrides": [
    {
      "files": ["scripts/**"],
      "rules": {
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      "files": ["src/routes/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [{ "regex": "^\\./[^.]", "message": "Route modules must not import sibling route modules." }]
          }
        ]
      }
    },
    {
      "files": ["src/core/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(?:node:)?(?:assert|async_hooks|buffer|child_process|cluster|console|constants|crypto|dgram|diagnostics_channel|dns|domain|events|fs|http|http2|https|inspector|module|net|os|path|perf_hooks|process|punycode|querystring|readline|repl|stream|string_decoder|timers|tls|trace_events|tty|url|util|v8|vm|wasi|worker_threads|zlib)(?:/|$)",
                "message": "Core modules must remain free of IO. Import Node builtins nowhere in core."
              },
              {
                "regex": "^(@tanstack/|react(?:/|-|$)|@testing-library/|drizzle-orm(?:/|$)|postgres(?:/|$)|iovalkey(?:/|$)|ioredis(?:/|$)|@electric-sql/|better-auth(?:/|$)|cheerio(?:/|$)|html-to-text(?:/|$)|centrifuge(?:/|$)|posthog-js(?:/|$))",
                "message": "Core modules must remain free of framework and persistence dependencies. Zod is the sanctioned exception."
              },
              {
                "regex": "^\\.\\./(adapters|client|components|db|lib|routes|server)/",
                "message": "Core modules must not depend on application layers."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/server/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(?:\\.\\./)+(?:client|routes)/",
                "message": "Server modules must not depend on client or route modules."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/client/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(?:\\.\\./)+(?:adapters|db|routes)/",
                "message": "Client modules must not depend on adapters, database, or route modules."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/adapters/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(?:\\.\\./)+(?:client|db|routes|server)/",
                "message": "Adapters must not depend on application layers."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/db/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(?:\\.\\./)+(?:adapters|client|routes|server)/",
                "message": "Database modules must depend only on core contracts and persistence code."
              }
            ]
          }
        ]
      }
    }
  ],
  "ignorePatterns": ["src/routeTree.gen.ts", ".output/**", "node_modules/**", "src/components/ui/**"],
  "env": {
    "builtin": true
  }
}
